[Unit]
Requires=flaresolverr.container
After=flaresolverr.container

[Container]
Image=lscr.io/linuxserver/jackett:latest
Label=io.containers.autoupdate=registry
PublishPort=127.0.0.1:9117:9117
RemapUsers=keep-id
Volume=/etc/jackett:/config:rw
Volume=jacket-downloads:/downloads:rw
Environment=AUTO_UPDATE=false
Network=arr.network
ContainerName=jackett

[Service]
SuccessExitStatus=0

[Install]
WantedBy=default.target