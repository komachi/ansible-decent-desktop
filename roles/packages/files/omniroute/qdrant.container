
[Container]
Image=docker.io/qdrant/qdrant:latest
Label=io.containers.autoupdate=registry
PublishPort=127.0.0.1:6333:6333
PublishPort=127.0.0.1:6334:6334
RemapUsers=keep-id
Volume=qdrant-storage:/qdrant/storage:rw
Volume=/etc/qdrant:/qdrant/config:ro
Environment=QDRANT__TELEMETRY_DISABLED=true
Network=omniroute.network
ContainerName=qdrant

[Service]
SuccessExitStatus=0

[Install]
WantedBy=default.target