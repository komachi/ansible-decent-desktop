
[Container]
Image=ghcr.io/ggml-org/llama.cpp:server-vulkan
Label=io.containers.autoupdate=registry
PublishPort=127.0.0.1:8091:8080
RemapUsers=keep-id
Volume=/var/lib/llamacpp/models:/models:Z
Exec=--embeddings -m /models/nomic-embed-text-v1.5.Q4_K_S.gguf --host 0.0.0.0 --port 8080 --ubatch-size 768
Network=omniroute.network
ContainerName=llamacpp
AddDevice=/dev/dri:/dev/dri

[Service]
SuccessExitStatus=0

[Install]
WantedBy=default.target
